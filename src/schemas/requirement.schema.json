{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-ai-factory.local/schemas/requirement.schema.json",
  "title": "Requirement artifact (contract 1.0.0)",
  "description": "Parsed representation of a requirement.md artifact. Produced by the extension's deterministic Markdown parser; the LLM never writes this document directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "context",
    "goals",
    "nonGoals",
    "requirements",
    "constraints",
    "assumptions",
    "openQuestions"
  ],
  "properties": {
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "context": {
      "$ref": "#/$defs/requiredText"
    },
    "goals": {
      "$ref": "#/$defs/nonEmptyList"
    },
    "nonGoals": {
      "$ref": "#/$defs/nullableList"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "description": "Consolidated requirement records. The original user statements remain in requirements-history.md and are cited via Source.",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "constraints": {
      "$ref": "#/$defs/nullableList"
    },
    "assumptions": {
      "$ref": "#/$defs/nullableText"
    },
    "openQuestions": {
      "$ref": "#/$defs/nullableText"
    },
    "stakeholders": {
      "$ref": "#/$defs/nullableText"
    },
    "changeHistory": {
      "$ref": "#/$defs/nullableText"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "description": "Machine-identifiable provenance of this artifact revision.",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "contractVersion",
        "changeId",
        "revision",
        "status"
      ],
      "properties": {
        "artifactType": {
          "const": "requirement",
          "description": "Must equal the contract's artifact type."
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version of the artifact contract this document follows."
        },
        "changeId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "The factory change id this artifact belongs to."
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Revision number the extension will record for this candidate."
        },
        "status": {
          "enum": [
            "draft",
            "complete"
          ],
          "description": "complete only when the document is ready for validation and review."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Optional ISO-8601 timestamp of the last edit."
        }
      }
    },
    "requiredText": {
      "type": "string",
      "minLength": 1,
      "description": "Free-form section content; must not be empty."
    },
    "nullableText": {
      "description": "Section content; null only when the documented not-applicable marker was used.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "nonEmptyList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Bullet list; at least one non-empty item."
    },
    "nullableList": {
      "description": "Bullet list; null only when the documented not-applicable marker was used.",
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "requirement": {
      "type": "object",
      "description": "One consolidated requirement (### REQ-###: title).",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "priority",
        "source",
        "rationale",
        "acceptanceIntent",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[0-9]{3,}$",
          "description": "Stable unique requirement id, e.g. REQ-001."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Short requirement title."
        },
        "priority": {
          "enum": [
            "MUST",
            "SHOULD",
            "COULD"
          ],
          "description": "Controlled priority."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Origin: a requirements-history entry id (R1, …) or 'Consolidated'."
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why this requirement exists."
        },
        "acceptanceIntent": {
          "type": "string",
          "minLength": 1,
          "description": "Expected outcome in observable terms."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "The requirement statement itself."
        }
      }
    }
  }
}
