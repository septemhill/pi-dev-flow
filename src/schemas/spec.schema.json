{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-ai-factory.local/schemas/spec.schema.json",
  "title": "Specification artifact (contract 1.1.0)",
  "description": "Parsed representation of a spec.md artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "scope",
    "referencedRequirements",
    "expectedBehavior",
    "functionalRequirements",
    "inputs",
    "outputs",
    "errorBehavior",
    "boundaryConditions",
    "acceptanceCriteria",
    "coverageReview",
    "verificationContract",
    "unresolvedQuestions"
  ],
  "properties": {
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "scope": {
      "$ref": "#/$defs/requiredText"
    },
    "referencedRequirements": {
      "type": "array",
      "minItems": 1,
      "description": "Requirement ids this spec addresses.",
      "items": {
        "type": "string",
        "pattern": "^REQ-[0-9]{3,}$"
      }
    },
    "expectedBehavior": {
      "$ref": "#/$defs/requiredText"
    },
    "functionalRequirements": {
      "description": "Functional requirement records; null when the documented not-applicable marker was used.",
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/functionalRequirement"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "$ref": "#/$defs/requiredText"
    },
    "outputs": {
      "$ref": "#/$defs/requiredText"
    },
    "errorBehavior": {
      "$ref": "#/$defs/requiredText"
    },
    "boundaryConditions": {
      "$ref": "#/$defs/nullableText"
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "description": "Externally verifiable acceptance criteria.",
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "verificationContract": {
      "$ref": "#/$defs/requiredText"
    },
    "coverageReview": {
      "$ref": "#/$defs/coverageReview"
    },
    "nonFunctionalRequirements": {
      "$ref": "#/$defs/nullableText"
    },
    "unresolvedQuestions": {
      "$ref": "#/$defs/nullableText"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "description": "Machine-identifiable provenance of this artifact revision.",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "contractVersion",
        "changeId",
        "revision",
        "status"
      ],
      "properties": {
        "artifactType": {
          "const": "spec",
          "description": "Must equal the contract's artifact type."
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version of the artifact contract this document follows."
        },
        "changeId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "The factory change id this artifact belongs to."
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Revision number the extension will record for this candidate."
        },
        "status": {
          "enum": [
            "draft",
            "complete"
          ],
          "description": "complete only when the document is ready for validation and review."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Optional ISO-8601 timestamp of the last edit."
        }
      }
    },
    "requiredText": {
      "type": "string",
      "minLength": 1,
      "description": "Free-form section content; must not be empty."
    },
    "nullableText": {
      "description": "Section content; null only when the documented not-applicable marker was used.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "functionalRequirement": {
      "type": "object",
      "description": "One functional requirement (### FR-###: title).",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "references",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FR-[0-9]{3,}$",
          "description": "Stable unique functional-requirement id."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Short title."
        },
        "references": {
          "type": "string",
          "minLength": 1,
          "description": "Comma-separated requirement ids this FR derives from."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "The mandated behavior."
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "description": "One acceptance criterion (### AC-###: title).",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "references",
        "verification",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[0-9]{3,}$",
          "description": "Stable unique acceptance-criterion id."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Short title."
        },
        "references": {
          "type": "string",
          "minLength": 1,
          "description": "Comma-separated requirement ids justifying this criterion (REQ-### and/or FR-###)."
        },
        "verification": {
          "type": "string",
          "minLength": 1,
          "description": "The command, test, or observable check that proves this criterion."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "The verifiable expected result."
        }
      }
    },
    "coverageReview": {
      "description": "Bounded semantic coverage review attestations; null when the documented not-applicable marker was used.",
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reviewRecord"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "upstream",
        "downstream",
        "stage",
        "status",
        "missingObligations",
        "rationale",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SR-[0-9]{3,}$",
          "description": "Stable unique review-record id."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "upstream": {
          "type": "string",
          "minLength": 1,
          "description": "The upstream item id this attestation is about."
        },
        "downstream": {
          "type": "string",
          "minLength": 1,
          "description": "The downstream item id that declares the relationship."
        },
        "stage": {
          "enum": [
            "requirement_to_spec",
            "spec_to_design",
            "spec_to_tasks",
            "tasks_to_implementation",
            "acceptance_to_verification"
          ]
        },
        "status": {
          "enum": [
            "COVERED",
            "PARTIAL",
            "NEEDS_REVIEW"
          ],
          "description": "A model attestation, never a success claim: it can never override a deterministic finding."
        },
        "missingObligations": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
