{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-ai-factory.local/schemas/verification-report.schema.json",
  "title": "Verification report artifact (contract 1.0.0)",
  "description": "Parsed representation of a verification-report.md artifact. Must mirror every check recorded with factory_check_record; the overall verdict is recomputed by the extension from recorded results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "pinnedRevisions",
    "scope",
    "checks",
    "coverage",
    "residualRisks",
    "overallVerdict"
  ],
  "properties": {
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "pinnedRevisions": {
      "type": "object",
      "description": "The exact spec and implementation revisions this report verifies.",
      "additionalProperties": false,
      "required": [
        "specificationRevision",
        "specificationHash",
        "implementationRevision",
        "implementationHash"
      ],
      "properties": {
        "specificationRevision": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Revision number of the approved spec artifact."
        },
        "specificationHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Full sha256 of the approved spec artifact."
        },
        "implementationRevision": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Revision number of the approved implementation-report artifact."
        },
        "implementationHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Full sha256 of the approved implementation-report artifact."
        }
      }
    },
    "scope": {
      "$ref": "#/$defs/requiredText"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "description": "Verification check records; must equal the recorded check set.",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/check"
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "type": "object",
              "required": [
                "actual",
                "evidence"
              ]
            }
          }
        ]
      }
    },
    "coverage": {
      "$ref": "#/$defs/requiredText"
    },
    "residualRisks": {
      "$ref": "#/$defs/nullableText"
    },
    "overallVerdict": {
      "type": "object",
      "description": "Declared verdict; the extension recomputes it and rejects conflicts.",
      "additionalProperties": false,
      "required": [
        "verdict"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "description": "PASS only if no required check FAILED or was SKIPPED."
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "description": "Machine-identifiable provenance of this artifact revision.",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "contractVersion",
        "changeId",
        "revision",
        "status"
      ],
      "properties": {
        "artifactType": {
          "const": "verification-report",
          "description": "Must equal the contract's artifact type."
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version of the artifact contract this document follows."
        },
        "changeId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "The factory change id this artifact belongs to."
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Revision number the extension will record for this candidate."
        },
        "status": {
          "enum": [
            "draft",
            "complete"
          ],
          "description": "complete only when the document is ready for validation and review."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Optional ISO-8601 timestamp of the last edit."
        }
      }
    },
    "requiredText": {
      "type": "string",
      "minLength": 1,
      "description": "Free-form section content; must not be empty."
    },
    "nullableText": {
      "description": "Section content; null only when the documented not-applicable marker was used.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "check": {
      "type": "object",
      "description": "One verification check (### CHK-###: description).",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "reference",
        "required",
        "method",
        "expected",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CHK-[0-9]{3,}$",
          "description": "Stable unique check id."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "What this check verifies."
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "The acceptance criterion / requirement id this check covers, or 'tooling' for build/test-infrastructure checks."
        },
        "required": {
          "enum": [
            "yes",
            "no"
          ],
          "description": "Whether this check gates the verdict."
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "The command or procedure executed."
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "description": "What success looks like."
        },
        "actual": {
          "type": "string",
          "minLength": 1,
          "description": "What actually happened (required for PASS/FAIL)."
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "SKIPPED",
            "NEEDS_HUMAN"
          ],
          "description": "Must equal the status recorded with factory_check_record (PASSED→PASS, FAILED→FAIL, SKIPPED→SKIPPED, MANUAL→NEEDS_HUMAN)."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Key output, truncated but real (required for PASS/FAIL)."
        },
        "description": {
          "type": "string",
          "description": "Optional narrative."
        }
      }
    }
  }
}
